# Neon Postgres connection string.
# Vercel dashboard -> Storage -> Create Database -> Neon Postgres.
# Vercel injects DATABASE_URL automatically once the store is connected;
# copy it here for local development.
# Replace this whole value. The app refuses to start until you do.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# OpenAI API key, used for word explanations and HSK-level rewrites.
# Paste your real key. A .env.local value shadows any key already in your shell.
OPENAI_API_KEY="sk-..."

# Optional: model override. Defaults to gpt-5.5.
OPENAI_MODEL="gpt-5.5"

# Secret for the scheduled feed refresh. Vercel Cron sends this as a
# Bearer token; generate any long random string.
CRON_SECRET="change-me-to-a-long-random-string"
